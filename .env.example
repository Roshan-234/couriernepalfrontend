# Local development; browser traffic always uses same-origin /api.
BACKEND_URL=http://127.0.0.1:5000
SITE_URL=https://couriernepal.com
# Keep blank locally, or set the same secret on both servers.
BACKEND_PROXY_SECRET=
# Optional: real GA4 ID and Google Search Console verification value.
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
ENABLE_HSTS=false
